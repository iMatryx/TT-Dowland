# Lasă gol pentru teste și `python -m bot.main --check`.
# Completează numai în .env local când activezi long polling cu BotFather.
BOT_TOKEN=
DOWNLOAD_DIR=downloads
# Limită locală în MiB. Senderul aplică separat limita standard Telegram de 50 MB.
MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_DOWNLOADS=3
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_DB_PATH=data/cache.sqlite3
CACHE_TTL_SECONDS=604800
# Coada este în memorie; nu se reia automat după repornire.
MAX_PENDING_REQUESTS=32
USER_REQUESTS_PER_MINUTE=5
USER_COOLDOWN_SECONDS=2
MAX_USER_OPERATIONS=1
OPERATION_TIMEOUT_SECONDS=300
UPLOAD_TIMEOUT_SECONDS=120
HTTP_MAX_CONNECTIONS=6
CLEANUP_INTERVAL_SECONDS=300
ABANDONED_FILE_SECONDS=3600
SHUTDOWN_GRACE_SECONDS=15
# false: scanare ffprobe a pachetelor; true: și decodare integrală FFmpeg.
VERIFY_FULL_DECODE=false

